<?xml version="1.0" encoding="UTF-8"?>
<robot name="g1_29dof_rev_1_0_with_inspire_hand_DFQ" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- use_pelvis_lift: include the virtual pelvis_height_joint (gear_sonic squat
         planning). The URDF must be generated with the same arg. -->
    <xacro:arg name="use_pelvis_lift" default="false"/>
    <xacro:property name="waist_chain_base" value="${'pelvis_lift_base' if '$(arg use_pelvis_lift)' == 'true' else 'pelvis'}"/>

    <group name="right_arm">
        <joint name="right_shoulder_pitch_joint"/>
        <joint name="right_shoulder_roll_joint"/>
        <joint name="right_shoulder_yaw_joint"/>
        <joint name="right_elbow_joint"/>
        <joint name="right_wrist_roll_joint"/>
        <joint name="right_wrist_pitch_joint"/>
        <joint name="right_wrist_yaw_joint"/>
    </group>

    <group name="left_arm">
        <joint name="left_shoulder_pitch_joint"/>
        <joint name="left_shoulder_roll_joint"/>
        <joint name="left_shoulder_yaw_joint"/>
        <joint name="left_elbow_joint"/>
        <joint name="left_wrist_roll_joint"/>
        <joint name="left_wrist_pitch_joint"/>
        <joint name="left_wrist_yaw_joint"/>
    </group>

    <group name="left_arm_with_waist">
        <chain base_link="${waist_chain_base}" tip_link="left_wrist_yaw_link"/>
    </group>

    <group name="right_arm_with_waist">
        <chain base_link="${waist_chain_base}" tip_link="right_wrist_yaw_link"/>
    </group>

    <group name="both_arms_with_waist">
        <xacro:if value="$(arg use_pelvis_lift)">
            <joint name="pelvis_height_joint"/>
        </xacro:if>
        <joint name="waist_yaw_joint"/>
        <joint name="waist_roll_joint"/>
        <joint name="waist_pitch_joint"/>
        <joint name="left_shoulder_pitch_joint"/>
        <joint name="left_shoulder_roll_joint"/>
        <joint name="left_shoulder_yaw_joint"/>
        <joint name="left_elbow_joint"/>
        <joint name="left_wrist_roll_joint"/>
        <joint name="left_wrist_pitch_joint"/>
        <joint name="left_wrist_yaw_joint"/>
        <joint name="right_shoulder_pitch_joint"/>
        <joint name="right_shoulder_roll_joint"/>
        <joint name="right_shoulder_yaw_joint"/>
        <joint name="right_elbow_joint"/>
        <joint name="right_wrist_roll_joint"/>
        <joint name="right_wrist_pitch_joint"/>
        <joint name="right_wrist_yaw_joint"/>
    </group>

    <group name="right_hand">
        <joint name="R_thumb_proximal_yaw_joint"/>
        <joint name="R_thumb_proximal_pitch_joint"/>
        <joint name="R_index_proximal_joint"/>
        <joint name="R_middle_proximal_joint"/>
        <joint name="R_ring_proximal_joint"/>
        <joint name="R_pinky_proximal_joint"/>
    </group>

    <group name="left_hand">
        <joint name="L_thumb_proximal_yaw_joint"/>
        <joint name="L_thumb_proximal_pitch_joint"/>
        <joint name="L_index_proximal_joint"/>
        <joint name="L_middle_proximal_joint"/>
        <joint name="L_ring_proximal_joint"/>
        <joint name="L_pinky_proximal_joint"/>
    </group>

    <group_state name="home" group="right_arm">
        <joint name="right_shoulder_pitch_joint" value="0"/>
        <joint name="right_shoulder_roll_joint" value="0"/>
        <joint name="right_shoulder_yaw_joint" value="0"/>
        <joint name="right_elbow_joint" value="0"/>
        <joint name="right_wrist_roll_joint" value="0"/>
        <joint name="right_wrist_pitch_joint" value="0"/>
        <joint name="right_wrist_yaw_joint" value="0"/>
    </group_state>

    <group_state name="home" group="left_arm">
        <joint name="left_shoulder_pitch_joint" value="0"/>
        <joint name="left_shoulder_roll_joint" value="0"/>
        <joint name="left_shoulder_yaw_joint" value="0"/>
        <joint name="left_elbow_joint" value="0"/>
        <joint name="left_wrist_roll_joint" value="0"/>
        <joint name="left_wrist_pitch_joint" value="0"/>
        <joint name="left_wrist_yaw_joint" value="0"/>
    </group_state>

    <end_effector name="right_hand_end_effector" parent_link="right_wrist_yaw_link" group="right_hand" parent_group="right_arm"/>
    <end_effector name="left_hand_end_effector" parent_link="left_wrist_yaw_link" group="left_hand" parent_group="left_arm"/>

    <xacro:if value="$(arg use_pelvis_lift)">
        <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="pelvis_lift_base"/>
    </xacro:if>
    <xacro:unless value="$(arg use_pelvis_lift)">
        <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="pelvis"/>
    </xacro:unless>

    <!-- Pelvis -->
    <disable_collisions link1="pelvis" link2="pelvis_contour_link" reason="Adjacent"/>
    <disable_collisions link1="pelvis" link2="imu_in_pelvis" reason="Adjacent"/>

    <!-- Left leg -->
    <disable_collisions link1="pelvis" link2="left_hip_pitch_link" reason="Adjacent"/>
    <disable_collisions link1="left_hip_pitch_link" link2="left_hip_roll_link" reason="Adjacent"/>
    <disable_collisions link1="left_hip_roll_link" link2="left_hip_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="left_hip_yaw_link" link2="left_knee_link" reason="Adjacent"/>
    <disable_collisions link1="left_knee_link" link2="left_ankle_pitch_link" reason="Adjacent"/>
    <disable_collisions link1="left_ankle_pitch_link" link2="left_ankle_roll_link" reason="Adjacent"/>

    <!-- Right leg -->
    <disable_collisions link1="pelvis" link2="right_hip_pitch_link" reason="Adjacent"/>
    <disable_collisions link1="right_hip_pitch_link" link2="right_hip_roll_link" reason="Adjacent"/>
    <disable_collisions link1="right_hip_roll_link" link2="right_hip_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="right_hip_yaw_link" link2="right_knee_link" reason="Adjacent"/>
    <disable_collisions link1="right_knee_link" link2="right_ankle_pitch_link" reason="Adjacent"/>
    <disable_collisions link1="right_ankle_pitch_link" link2="right_ankle_roll_link" reason="Adjacent"/>

    <!-- The DFQ attention pose leaves the right thumb mesh touching the hip
         mesh by only a few tens of micrometres.  Treat that numerical contact
         as a default-pose pair so a collision-free arm motion can leave the
         attention pose; all other hand-to-body pairs remain checked. -->
    <disable_collisions link1="right_hip_yaw_link" link2="R_thumb_intermediate" reason="Default"/>
    <disable_collisions link1="right_hip_yaw_link" link2="R_thumb_distal" reason="Default"/>
    <disable_collisions link1="right_hip_roll_link" link2="R_thumb_proximal" reason="Default"/>

    <!-- Waist (pelvis -> waist_yaw_link -> waist_roll_link -> torso_link) -->
    <disable_collisions link1="pelvis" link2="waist_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="waist_yaw_link" link2="waist_roll_link" reason="Adjacent"/>
    <disable_collisions link1="waist_roll_link" link2="torso_link" reason="Adjacent"/>

    <!-- Torso and attached links -->
    <disable_collisions link1="torso_link" link2="head_link" reason="Adjacent"/>
    <disable_collisions link1="torso_link" link2="logo_link" reason="Adjacent"/>
    <disable_collisions link1="torso_link" link2="imu_in_torso" reason="Adjacent"/>
    <disable_collisions link1="torso_link" link2="d435_link" reason="Adjacent"/>
    <disable_collisions link1="torso_link" link2="mid360_link" reason="Adjacent"/>

    <!-- Left arm (torso_link -> shoulder -> ... -> wrist) -->
    <disable_collisions link1="torso_link" link2="left_shoulder_pitch_link" reason="Adjacent"/>
    <disable_collisions link1="left_shoulder_pitch_link" link2="left_shoulder_roll_link" reason="Adjacent"/>
    <disable_collisions link1="left_shoulder_roll_link" link2="left_shoulder_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="left_shoulder_yaw_link" link2="left_elbow_link" reason="Adjacent"/>
    <disable_collisions link1="left_elbow_link" link2="left_wrist_roll_link" reason="Adjacent"/>
    <disable_collisions link1="left_wrist_roll_link" link2="left_wrist_pitch_link" reason="Adjacent"/>
    <disable_collisions link1="left_wrist_pitch_link" link2="left_wrist_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="left_wrist_yaw_link" link2="L_hand_base_link" reason="Adjacent"/>

    <!-- Right arm (torso_link -> shoulder -> ... -> wrist) -->
    <disable_collisions link1="torso_link" link2="right_shoulder_pitch_link" reason="Adjacent"/>
    <disable_collisions link1="right_shoulder_pitch_link" link2="right_shoulder_roll_link" reason="Adjacent"/>
    <disable_collisions link1="right_shoulder_roll_link" link2="right_shoulder_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="right_shoulder_yaw_link" link2="right_elbow_link" reason="Adjacent"/>
    <disable_collisions link1="right_elbow_link" link2="right_wrist_roll_link" reason="Adjacent"/>
    <disable_collisions link1="right_wrist_roll_link" link2="right_wrist_pitch_link" reason="Adjacent"/>
    <disable_collisions link1="right_wrist_pitch_link" link2="right_wrist_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="right_wrist_yaw_link" link2="R_hand_base_link" reason="Adjacent"/>

    <!-- RH56DFX hand self-collisions
         Temporarily disable collisions between all links within each hand because
         the interference relationships are complex. -->
    <!-- Left RH56DFX hand -->
    <disable_collisions link1="L_hand_base_link" link2="L_thumb_proximal_base" reason="Temporary"/>
    <disable_collisions link1="L_hand_base_link" link2="L_thumb_proximal" reason="Temporary"/>
    <disable_collisions link1="L_hand_base_link" link2="L_thumb_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_hand_base_link" link2="L_thumb_distal" reason="Temporary"/>
    <disable_collisions link1="L_hand_base_link" link2="L_index_proximal" reason="Temporary"/>
    <disable_collisions link1="L_hand_base_link" link2="L_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_hand_base_link" link2="L_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="L_hand_base_link" link2="L_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_hand_base_link" link2="L_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="L_hand_base_link" link2="L_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_hand_base_link" link2="L_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="L_hand_base_link" link2="L_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal_base" link2="L_thumb_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal_base" link2="L_thumb_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal_base" link2="L_thumb_distal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal_base" link2="L_index_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal_base" link2="L_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal_base" link2="L_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal_base" link2="L_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal_base" link2="L_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal_base" link2="L_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal_base" link2="L_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal_base" link2="L_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal" link2="L_thumb_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal" link2="L_thumb_distal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal" link2="L_index_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal" link2="L_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal" link2="L_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal" link2="L_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal" link2="L_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal" link2="L_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal" link2="L_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_proximal" link2="L_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_intermediate" link2="L_thumb_distal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_intermediate" link2="L_index_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_intermediate" link2="L_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_intermediate" link2="L_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_intermediate" link2="L_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_intermediate" link2="L_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_intermediate" link2="L_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_intermediate" link2="L_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_intermediate" link2="L_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_distal" link2="L_index_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_distal" link2="L_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_distal" link2="L_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_distal" link2="L_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_distal" link2="L_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_distal" link2="L_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_thumb_distal" link2="L_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="L_thumb_distal" link2="L_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_index_proximal" link2="L_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_index_proximal" link2="L_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="L_index_proximal" link2="L_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_index_proximal" link2="L_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="L_index_proximal" link2="L_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_index_proximal" link2="L_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="L_index_proximal" link2="L_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_index_intermediate" link2="L_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="L_index_intermediate" link2="L_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_index_intermediate" link2="L_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="L_index_intermediate" link2="L_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_index_intermediate" link2="L_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="L_index_intermediate" link2="L_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_middle_proximal" link2="L_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_middle_proximal" link2="L_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="L_middle_proximal" link2="L_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_middle_proximal" link2="L_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="L_middle_proximal" link2="L_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_middle_intermediate" link2="L_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="L_middle_intermediate" link2="L_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_middle_intermediate" link2="L_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="L_middle_intermediate" link2="L_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_ring_proximal" link2="L_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_ring_proximal" link2="L_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="L_ring_proximal" link2="L_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_ring_intermediate" link2="L_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="L_ring_intermediate" link2="L_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="L_pinky_proximal" link2="L_pinky_intermediate" reason="Temporary"/>

    <!-- Right RH56DFX hand -->
    <disable_collisions link1="R_hand_base_link" link2="R_thumb_proximal_base" reason="Temporary"/>
    <disable_collisions link1="R_hand_base_link" link2="R_thumb_proximal" reason="Temporary"/>
    <disable_collisions link1="R_hand_base_link" link2="R_thumb_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_hand_base_link" link2="R_thumb_distal" reason="Temporary"/>
    <disable_collisions link1="R_hand_base_link" link2="R_index_proximal" reason="Temporary"/>
    <disable_collisions link1="R_hand_base_link" link2="R_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_hand_base_link" link2="R_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="R_hand_base_link" link2="R_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_hand_base_link" link2="R_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="R_hand_base_link" link2="R_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_hand_base_link" link2="R_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="R_hand_base_link" link2="R_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal_base" link2="R_thumb_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal_base" link2="R_thumb_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal_base" link2="R_thumb_distal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal_base" link2="R_index_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal_base" link2="R_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal_base" link2="R_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal_base" link2="R_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal_base" link2="R_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal_base" link2="R_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal_base" link2="R_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal_base" link2="R_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal" link2="R_thumb_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal" link2="R_thumb_distal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal" link2="R_index_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal" link2="R_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal" link2="R_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal" link2="R_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal" link2="R_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal" link2="R_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal" link2="R_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_proximal" link2="R_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_intermediate" link2="R_thumb_distal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_intermediate" link2="R_index_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_intermediate" link2="R_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_intermediate" link2="R_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_intermediate" link2="R_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_intermediate" link2="R_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_intermediate" link2="R_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_intermediate" link2="R_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_intermediate" link2="R_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_distal" link2="R_index_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_distal" link2="R_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_distal" link2="R_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_distal" link2="R_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_distal" link2="R_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_distal" link2="R_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_thumb_distal" link2="R_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="R_thumb_distal" link2="R_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_index_proximal" link2="R_index_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_index_proximal" link2="R_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="R_index_proximal" link2="R_middle_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_index_proximal" link2="R_ring_proximal" reason="Temporary"/>
    <disable_collisions link1="R_index_proximal" link2="R_ring_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_index_proximal" link2="R_pinky_proximal" reason="Temporary"/>
    <disable_collisions link1="R_index_proximal" link2="R_pinky_intermediate" reason="Temporary"/>
    <disable_collisions link1="R_index_intermediate" link2="R_middle_proximal" reason="Temporary"/>
    <disable_collisions link1="R_index_intermediate" link2="R_middle_intermediate" reason="Temporary"/>
