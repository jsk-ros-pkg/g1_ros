  <version>0.0.0</version>
  <description>Launch files to bring up the Unitree G1 robot with MoveIt2 and real hardware</description>
  <maintainer email="mqcmd196@hotmail.co.jp">Yoshiki Obinata</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <exec_depend>compressed_depth_image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>
