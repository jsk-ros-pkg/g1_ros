Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
  - Class: rviz_common/Help
    Name: Help
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Alpha: 0.5
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description File: ""
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      TF Prefix: ""
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Temperature
      Name: Winding Temperature
      Decay Time: 2
      Size (m): 0.08
      Style: Spheres
      Topic:
        Depth: 100
        Durability Policy: Volatile
        Filter size: 100
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /motor_temperatures/winding
      Value: true
    - Class: rviz_default_plugins/Temperature
      Name: Casing Temperature
      Decay Time: 2
      Size (m): 0.08
      Style: Spheres
      Topic:
        Depth: 100
        Durability Policy: Volatile
        Filter size: 100
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /motor_temperatures/casing
      Value: false
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Planning Request:
        Planning Group: both_arms_with_waist
      Planned Path:
        Loop Animation: false
        State Display Time: 0.05 s
        Trajectory Topic: display_planned_path
      Planning Scene Topic: monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 1
      Scene Robot:
        Robot Alpha: 0.5
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: D435i PointCloud (zstd)
      Color Transformer: RGB8
      Size (Pixels): 3
      Size (m): 0.01
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /head_camera/d435/depth/color/points/zstd
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: D435i PointCloud (rebuilt, playback)
      Color Transformer: RGB8
      Size (Pixels): 3
      Size (m): 0.01
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /head_camera/d435/depth/color/points
      Value: false
    - Class: rviz_default_plugins/Image
      Name: D435i Color (compressed)
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /head_camera/d435/color/image_raw/compressed
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Livox Mid-360
      Axis: Z
      Color Transformer: AxisColor
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /livox/lidar
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Livox Mid-360 (zstd, playback)
      Axis: Z
      Color Transformer: AxisColor
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /livox/lidar/zstd
      Value: false
  Global Options:
    Fixed Frame: pelvis
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: -0.1
        Y: 0.25
        Z: 0.30
      Name: Current View
      Pitch: 0.5
      Target Frame: pelvis
      Yaw: 2.519
Window Geometry:
  D435i Color (compressed):
    collapsed: false
  Displays:
    collapsed: false
  Height: 975
  QMainWindow State: 
  Width: 1200
