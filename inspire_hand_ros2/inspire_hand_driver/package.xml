<?xml version="1.0"?>
<package format="3">
  <name>inspire_hand_driver</name>
  <version>0.0.0</version>
  <description>ROS 2 control driver for Inspire RH56DFX serial hands</description>
  <maintainer email="mqcmd196@hotmail.co.jp">Yoshiki Obinata</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <depend>hardware_interface</depend>
  <depend>inspire_hand_interfaces</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>xacro</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
