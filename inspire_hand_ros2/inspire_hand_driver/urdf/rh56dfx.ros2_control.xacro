<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rh56dfx_control_joint" params="name index lower closed deactivate">
    <joint name="${name}">
      <param name="motor_index">${index}</param>
      <param name="closed_position">${closed}</param>
      <param name="deactivation_position">${deactivate}</param>
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${closed}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="rh56dfx_control_joints" params="prefix offset:=0">
    <!-- Serial motor order, from little finger to thumb rotation. -->
    <xacro:rh56dfx_control_joint name="${prefix}pinky_proximal_joint" index="${offset + 0}" lower="0.0" closed="1.7" deactivate="1.7"/>
    <xacro:rh56dfx_control_joint name="${prefix}ring_proximal_joint" index="${offset + 1}" lower="0.0" closed="1.7" deactivate="1.7"/>
    <xacro:rh56dfx_control_joint name="${prefix}middle_proximal_joint" index="${offset + 2}" lower="0.0" closed="1.7" deactivate="1.7"/>
    <xacro:rh56dfx_control_joint name="${prefix}index_proximal_joint" index="${offset + 3}" lower="0.0" closed="1.7" deactivate="1.7"/>
    <xacro:rh56dfx_control_joint name="${prefix}thumb_proximal_pitch_joint" index="${offset + 4}" lower="-0.1" closed="0.6" deactivate="0.6"/>
    <xacro:rh56dfx_control_joint name="${prefix}thumb_proximal_yaw_joint" index="${offset + 5}" lower="-0.1" closed="1.3" deactivate="0.3"/>
  </xacro:macro>
  <xacro:macro name="rh56dfx_serial_system" params="name prefix device action_prefix close_hand_on_deactivate:=true">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>inspire_hand_driver/RH56DFXHardware</plugin>
        <param name="device">${device}</param>
        <param name="action_prefix">${action_prefix}</param>
        <param name="close_hand_on_deactivate">${close_hand_on_deactivate}</param>
      </hardware>
      <xacro:rh56dfx_control_joints prefix="${prefix}"/>
    </ros2_control>
  </xacro:macro>
</robot>
