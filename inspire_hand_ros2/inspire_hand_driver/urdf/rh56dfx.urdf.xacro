<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rh56dfx">
  <xacro:arg name="device" default="/dev/ttyUSB0"/>
  <xacro:arg name="side" default="right"/>
  <xacro:arg name="action_prefix" default="/inspire_hand"/>
  <xacro:arg name="close_hand_on_deactivate" default="true"/>
  <xacro:include filename="rh56dfx.ros2_control.xacro"/>
  <xacro:property name="left" value="${'$(arg side)' == 'left'}"/>
  <!-- Kinematic frames of the six actuated RH56DFX joints (radians). -->
  <link name="hand_base_link"/>
  <xacro:macro name="finger_joint" params="name parent:=hand_base_link xyz rpy axis lower upper">
    <link name="${name}"/>
    <joint name="${name}_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" velocity="0.5" effort="1"/>
    </joint>
  </xacro:macro>
  <xacro:property name="finger_axis" value="0 0 ${-1 if left else 1}"/>
  <xacro:finger_joint name="thumb_proximal_yaw" xyz="-0.01696 -0.0691 ${0.02045 if left else -0.02045}" rpy="1.5708 -1.5708 0" axis="0 0 ${1 if left else -1}" lower="-0.1" upper="1.3"/>
  <xacro:finger_joint name="thumb_proximal_pitch" parent="thumb_proximal_yaw" xyz="${'0.0099867 0.0098242 -0.0089' if left else '-0.0088099 0.010892 -0.00925'}" rpy="${'-1.5708 0 0.16939' if left else '1.5708 0 2.8587'}" axis="${finger_axis}" lower="-0.1" upper="0.6"/>
  <xacro:finger_joint name="index_proximal" xyz="0.00028533 -0.13653 ${0.032268 if left else -0.032268}" rpy="${-0.034907 if left else -3.1067} 0 0" axis="${finger_axis}" lower="0" upper="1.7"/>
  <xacro:finger_joint name="middle_proximal" xyz="0.00028533 -0.1371 ${0.01295 if left else -0.01295}" rpy="${0 if left else -3.1416} 0 0" axis="${finger_axis}" lower="0" upper="1.7"/>
  <xacro:finger_joint name="ring_proximal" xyz="0.00028533 -0.13691 ${-0.0062872 if left else 0.0062872}" rpy="${0.05236 if left else 3.0892} 0 0" axis="${finger_axis}" lower="0" upper="1.7"/>
  <xacro:finger_joint name="pinky_proximal" xyz="0.00028533 -0.13571 ${-0.025488 if left else 0.025488}" rpy="${0.10472 if left else 3.0369} 0 0" axis="${finger_axis}" lower="0" upper="1.7"/>
  <xacro:rh56dfx_serial_system name="RH56DFX" prefix="" device="$(arg device)" action_prefix="$(arg action_prefix)" close_hand_on_deactivate="$(arg close_hand_on_deactivate)"/>
</robot>
