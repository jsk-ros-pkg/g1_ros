<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_hardware</name>
  <version>0.0.0</version>
  <description>ros2_control hardware interface plugin for the Unitree G1 robot upper body</description>
  <maintainer email="mqcmd196@hotmail.co.jp">Yoshiki Obinata</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <depend>audio_common_msgs</depend>
  <depend>control_msgs</depend>
  <depend>gear_sonic_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>kdl_parser</depend>
  <depend>libzmq3-dev</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>sound_play_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_msgs</depend>
  <depend>unitree_sdk2</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>g1_description</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_clang_tidy</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/g1_hardware_plugin.xml"/>
  </export>
</package>
